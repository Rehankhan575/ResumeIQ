# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment secrets ──────────────────────────────────────────────────────
.env
*.env.local

# ── Lock files / Local dev artifacts ─────────────────────────────────────────
requirements-lock.txt

# ── Data (raw & processed content ignored, .gitkeep preserved) ───────────────
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ── Model artifacts (binary checkpoints ignored, .gitkeep preserved) ─────────
artifacts/models/*
!artifacts/models/.gitkeep

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Build ────────────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
